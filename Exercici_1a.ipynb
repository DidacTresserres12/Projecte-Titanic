# Ejercicio 1a - Potencial y campo eléctrico de varias cargas
# Lee un archivo FAC_EE1.csv con q, x, y, z (en unidades de e y nm)
# Calcula el potencial y el campo total en una posición (x, y, z) introducida por teclado

import numpy as np
import csv

kCe = 1.44  # V·nm  (constante de Coulomb por e)

# Leer el archivo CSV
cargas = []
with open("FAC_EE1.csv") as f:
    lector = csv.reader(f)
    for fila in lector:
        q, x, y, z = map(int, fila)
        cargas.append((q, x, y, z))

# Leer la posición donde queremos calcular (x, y, z)
x, y, z = map(int, input("Introduce x, y, z (en nm, separados por espacios): ").split())
r = np.array([x, y, z], float)

# Calcular potencial y campo eléctrico
V = 0.0
E = np.zeros(3)

for q, xb, yb, zb in cargas:
    rb = np.array([xb, yb, zb], float)
    dr = r - rb
    r_mod = np.linalg.norm(dr)
    if r_mod != 0:
        V += kCe * q / r_mod
        E += kCe * q * dr / (r_mod**3)

E = -E  # signo negativo (E = -grad V)

print("\nResultados:")
print(f"Potencial total: {V:.6f} V")
print(f"Campo eléctrico total: ({E[0]:.6f}, {E[1]:.6f}, {E[2]:.6f}) V/nm")
